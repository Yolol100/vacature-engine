{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VacatureEngineJobRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "source_job_id", "title", "employer", "job_url", "fetched_at", "raw", "canonical_url", "vacancy_id"],
  "properties": {
    "source": {"type": "string", "minLength": 1},
    "source_job_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "employer": {"type": "string", "minLength": 1},
    "job_url": {"type": "string", "format": "uri"},
    "apply_url": {"type": ["string", "null"], "format": "uri"},
    "location": {"type": ["string", "null"]},
    "is_remote": {"type": ["boolean", "null"]},
    "employment_type": {"type": ["string", "null"]},
    "department": {"type": ["string", "null"]},
    "team": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "posted_at": {"type": ["string", "null"], "format": "date-time"},
    "source_date": {"type": ["string", "null"]},
    "source_date_semantics": {"type": ["string", "null"]},
    "salary_summary": {"type": ["string", "null"]},
    "fetched_at": {"type": "string", "format": "date-time"},
    "raw": {"type": "object"},
    "canonical_url": {"type": "string", "format": "uri"},
    "vacancy_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
  }
}
