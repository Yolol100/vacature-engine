        "site:job-boards.greenhouse.io WooCommerce remote",
        "site:jobs.lever.co web developer remote",
        "AI workflow automation engineer remote Europe"
      ],
      "max_pages": 10,
      "max_requests_per_run": 12,
      "free_quota_reserve": 10
    }
  }
]
